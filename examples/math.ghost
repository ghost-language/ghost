// The math module works on one number at a time, and on whole lists of them.

// Scalars.
print(math.sqrt(16))
print(math.pow(2, 10))
print(math.round(2.567, 2))
print(math.log(8, 2))
print(math.degrees(math.pi))
print(math.clamp(15, 0, 10))
print(math.isClose(0.1 + 0.2, 0.3))

// Every elementwise method broadcasts. A number held against a list applies to
// each element, two lists apply pairwise, and nesting is followed all the way
// down.
print(math.sqrt([1, 4, 9]))
print(math.sqrt([[1, 4], [9, 16]]))
print(math.add([1, 2, 3], 10))
print(math.multiply([1, 2, 3], [4, 5, 6]))

// Statistics read their values however they are held: spread across the call,
// collected in a list, or arranged as a matrix.
scores = [72, 85, 90, 90, 61, 78]

print(math.mean(scores))
print(math.median(scores))
print(math.mode(scores))
print(math.standardDeviation(scores))
print(math.percentile(scores, 90))
print(math.min(scores), math.max(scores))
print(math.sort(scores))

// Building lists of numbers.
print(math.arange(0, 1, 0.25))
print(math.linspace(0, 1, 5))
print(math.zeros(3))
print(math.identity(3))
print(math.reshape(math.arange(6), 2, 3))

// Vectors and matrices are lists and lists of lists.
print(math.dot([1, 2, 3], [4, 5, 6]))
print(math.norm([3, 4]))
print(math.normalize([3, 4]))
print(math.cross([1, 0, 0], [0, 1, 0]))
print(math.distance(0, 0, 3, 4))

matrix = [[4, 7], [2, 6]]

print(math.transpose(matrix))
print(math.determinant(matrix))
print(math.inverse(matrix))

// 2x + y = 5, x + 3y = 10
print(math.solve([[2, 1], [1, 3]], [5, 10]))

// Whole-number mathematics.
print(math.gcd(12, 18))
print(math.factorial(10))
print(math.isPrime(97))
print(math.combinations(52, 5))

// Random numbers share a seed with the random module, so a seeded run replays
// exactly. Noise drifts where random numbers jitter.
math.randomSeed(42)

print(math.random(1, 6))
print(math.noise(0.5, 1.5))
